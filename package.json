{
  "name": "ZynkHighlighter",
  "publisher": "guille-ux",
  "displayName": "Zynk Syntax Highlight",
  "description": "An extension for syntax highlight of zynk on VS Code",
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "zynk",
      "aliases": ["Zynk", "zynk"],
      "extensions": [".z",".zynk",".zk",".zn"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "zynk",
      "scopeName": "source.z",
      "path": "./syntaxes/zynk.tmLanguage.json"
    }]
  }
}
